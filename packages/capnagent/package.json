{
  "name": "@capnagent/core",
  "version": "0.9.0",
  "description": "Idiomatic TypeScript wrapper around the capnagent WASM artifact: capabilities, verification, and audit receipts for AI agent tool calls.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "capability",
    "authorization",
    "ai-agents",
    "mcp",
    "security",
    "macaroons",
    "wasm"
  ],
  "homepage": "https://capframe.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/euanmcrosson-dotcom/capnagent.git",
    "directory": "packages/capnagent"
  },
  "bugs": {
    "url": "https://github.com/euanmcrosson-dotcom/capnagent/issues"
  },
  "author": "Euan McRosson <euanmcrosson@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node -e \"require('fs').rmSync('wasm/.gitignore',{force:true})\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "5.6.3",
    "vite-plugin-top-level-await": "^1.2.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^2.1.9"
  }
}
