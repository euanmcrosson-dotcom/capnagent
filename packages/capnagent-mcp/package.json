{
  "name": "@capnagent/mcp",
  "version": "0.0.1",
  "description": "MCP-client adapter for capnagent: gates every tools/call with a capability, audits every decision.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["src"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capnagent/core": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "20.16.11",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
